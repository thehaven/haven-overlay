Dual V1/V2 entrypoint for opencode-pty.

Upstream dist/index.js only provides named exports ({ PTYPlugin, server }),
which OpenCode V1 accepts but V2 rejects:
  SchemaError(Missing key at ["default"])
V2 requires the default export to be an object with { id, setup|effect }.

This patch adds a default export that spreads the package's own V2 plugin
definition (dist/src/v2/index.js) and keeps the V1 `server` export. One
package now satisfies both runtimes.

--- a/dist/index.js
+++ b/dist/index.js
@@ -1,3 +1,6 @@
-export { PTYPlugin } from "./src/plugin.js";
-export { PTYPlugin as server } from "./src/plugin.js";
+import { PTYPlugin } from "./src/plugin.js";
+import { Plugin } from "./src/v2/index.js";
+export { PTYPlugin, PTYPlugin as server, Plugin };
+// Dual V1/V2 entrypoint: V2 reads `default` ({ id, setup }); V1 reads `server`.
+export default { ...Plugin, server: PTYPlugin };
