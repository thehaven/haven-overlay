EAPI=8

DESCRIPTION="Prime Agent: self-improving RLM coding research agent"
HOMEPAGE="https://github.com/PrimeIntellect-ai/prime-agent"

# Upstream rewrote the product from the TypeScript/npm monorepo (0.9.x) to a
# Rust workspace (crates/pa-*) in 0.10.2, so the build is cargo, not npm.
# The published release payload (scripts/release/assemble_artifacts.py) is ONE
# directory holding the binary plus its data peers: prime-agent-runtime/ (the
# Python kernel sidecar), skills/ and the bundled model/MCP catalogs. The
# binary resolves that directory from its own location
# (pa_core::packages::package_dir, $PI_PACKAGE_DIR being the override) and
# installs the sidecar from there into the kernel venv. The payload is
# therefore installed as one tree under /usr/libexec, and /usr/bin/prime-agent
# is a symlink into it so the real path still points at the payload.
SRC_URI="https://github.com/PrimeIntellect-ai/prime-agent/archive/refs/tags/v${PV}.tar.gz -> ${P}.tar.gz"
S="${WORKDIR}/prime-agent-${PV}"

# Upstream is MIT (the vendored crossterm patch is MIT too); the crates.io
# dependencies add Apache-2.0 and BSD.
LICENSE="MIT Apache-2.0 BSD"
SLOT="0"
KEYWORDS="~amd64"

# The bundled catalog is generated by a stdlib-only build-time script.
PYTHON_COMPAT=( python3_{12..14} )
inherit python-any-r1

# cargo resolves the crates.io dependencies pinned in Cargo.lock during
# src_compile, and the bundled model/MCP catalogs are fetched from the
# prime-agent-catalog repository at build time. Both need the network:
# RESTRICT="network-sandbox" OPENS it (man 5 ebuild); without the value the
# build is fully offline and cargo cannot reach crates.io.
RESTRICT="network-sandbox test"

# The kernel bootstrap creates a uv-managed venv (~/.prime/agent/kernel-venv)
# and installs the bundled prime-agent-runtime sidecar into it on first run.
RDEPEND="dev-python/uv"

# 1.97.1 builds the workspace (verified on this host; upstream CI pins 1.98.1).
BDEPEND="
	|| ( >=dev-lang/rust-1.97 >=dev-lang/rust-bin-1.97 )
	${PYTHON_DEPS}
"

src_compile() {
	# cargo needs a writable CARGO_HOME; the build user's home is not
	# guaranteed to have one.
	export CARGO_HOME="${WORKDIR}/cargo-home"
	mkdir -p "${CARGO_HOME}" || die

	# --locked keeps Cargo.lock authoritative (no silent dependency bumps).
	# -p pa-cli builds the prime-agent binary (crates/pa-cli/Cargo.toml
	# declares [[bin]] name = "prime-agent").
	cargo build --release --locked -p pa-cli || die

	# The release payload ships the bundled model/MCP catalogs next to the
	# binary; upstream CI generates them from the prime-agent-catalog repo
	# (scripts/release/bundle_catalog.py, stdlib only). A failure here is
	# not fatal: the binary falls back to its compiled-in model list.
	if ! ${PYTHON} "${S}/scripts/release/bundle_catalog.py" generate --network \
			--out "${WORKDIR}/catalog-assets"; then
		ewarn "prime-agent: bundled catalog generation failed;"
		ewarn "prime-agent: the binary falls back to its compiled-in model list."
	fi
}

src_install() {
	local payload="${D}/usr/libexec/${PN}"

	install -d "${payload}" || die

	# The binary. The payload directory IS the binary's own directory, so
	# the data peers installed below resolve without $PI_PACKAGE_DIR.
	install -m 0755 "${S}/target/release/prime-agent" "${payload}/prime-agent" || die

	# The Python kernel runtime sidecar: the binary installs THIS source
	# tree into the kernel venv with `uv pip install <dir>` on first run
	# (crates/pa-core/src/kernel/bootstrap/venv.rs). Only the wheel inputs
	# ship: pyproject.toml + src/rlm (upstream drops test/ and uv.lock from
	# the release payload).
	install -d "${payload}/prime-agent-runtime" || die
	cp -a "${S}/prime-agent-runtime/pyproject.toml" "${payload}/prime-agent-runtime/" || die
	cp -a "${S}/prime-agent-runtime/src" "${payload}/prime-agent-runtime/" || die
	find "${payload}/prime-agent-runtime" -name '__pycache__' -type d -prune -exec rm -rf {} + || die

	# The built-in skills (pa_core::packages::get_bundled_skills_dir).
	cp -a "${S}/skills" "${payload}/skills" || die

	# The bundled model/MCP catalogs, when the build could generate them.
	if [[ -d "${WORKDIR}/catalog-assets" ]]; then
		cp -a "${WORKDIR}/catalog-assets/." "${payload}/" || die
	fi

	# Launcher: a symlink, so the binary resolves the payload directory
	# from its real path (pa_core::packages::exe_dir_of).
	dosym "../libexec/${PN}/prime-agent" "/usr/bin/prime-agent"

	dodoc LICENSE README.md
	docinto prime-agent-runtime
	dodoc prime-agent-runtime/pyproject.toml
}

pkg_postinst() {
	elog "Prime Agent builds its Python kernel venv (~/.prime/agent/kernel-venv)"
	elog "on first run with uv; that step needs network access."
	elog ""
	elog "This is a portage-managed install: do NOT run 'prime-agent update',"
	elog "it would try to replace the payload in ${EPREFIX}/usr/libexec/${PN}."
	elog "Update with: emerge --update @world"
}
