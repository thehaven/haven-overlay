# OpenObserve environment configuration
# Environment variables used by OpenObserve daemon

ZO_DATA_DIR="/var/lib/openobserve"
ZO_HTTP_PORT=5080
ZO_GRPC_PORT=5081

# Initial administrator / root user credentials (used on initial setup)
# If not configured, OpenObserve generates a password on first startup.
#ZO_ROOT_USER_EMAIL="root@example.com"
#ZO_ROOT_USER_PASSWORD=""
