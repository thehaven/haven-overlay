DESCRIPTION="Manage active Bun JavaScript runtime and package manager version"
MAINTAINER="haven@thehavennet.org.uk"
VERSION="0.1"

show_selected_target() {
	if [[ -L "${EROOT}/usr/bin/bun" ]]; then
		basename "$(readlink "${EROOT}/usr/bin/bun")"
	fi
}

find_targets() {
	local f name
	for f in "${EROOT}"/usr/bin/bun-[0-9]*; do
		[[ -x "${f}" ]] || continue
		name="$(basename "${f}")"
		[[ "${name}" =~ ^bun-[0-9]+\.[0-9]+$ ]] || continue
		echo "${name}"
	done
}

remove_symlinks() {
	rm -f "${EROOT}/usr/bin/bun" "${EROOT}/usr/bin/bunx"
}

set_symlinks() {
	local target="${1}"
	if is_number "${target}"; then
		local targets=( $(find_targets) )
		target="${targets[target - 1]}"
	fi

	# Allow setting by slot shorthand (e.g. "1.3" -> "bun-1.3")
	if [[ "${target}" =~ ^[0-9]+\.[0-9]+$ ]]; then
		target="bun-${target}"
	fi

	[[ -z "${target}" || ! -x "${EROOT}/usr/bin/${target}" ]] &&
		die -q "Target \"${1}\" doesn't appear to be a valid installed Bun binary!"

	local slot="${target#bun-}"

	ln -sf "${target}" "${EROOT}/usr/bin/bun" || die -q "Failed to link /usr/bin/bun"

	if [[ -x "${EROOT}/usr/bin/bunx-${slot}" ]]; then
		ln -sf "bunx-${slot}" "${EROOT}/usr/bin/bunx" || die -q "Failed to link /usr/bin/bunx"
	fi
}

### show action ###

describe_show() {
	echo "Show current active Bun version"
}

do_show() {
	write_list_start "Current Bun version:"
	if [[ -L "${EROOT}/usr/bin/bun" ]]; then
		write_kv_list_entry "$(show_selected_target)" ""
	else
		write_kv_list_entry "(unset)" ""
	fi
}

### list action ###

describe_list() {
	echo "List available Bun versions"
}

do_list() {
	local targets=( $(find_targets) )
	local selected_target
	selected_target="$(show_selected_target)"

	write_list_start "Available Bun versions:"
	local i
	for ((i = 0; i < ${#targets[@]}; i++)); do
		[[ "${targets[i]}" == "${selected_target}" ]] && targets[i]="$(highlight_marker "${targets[i]}")"
	done
	write_numbered_list -m "(none found)" "${targets[@]}"
}

### set action ###

describe_set() {
	echo "Set active Bun version"
}

describe_set_parameters() {
	echo "<target>"
}

describe_set_options() {
	echo "target:      Target name (e.g. '1.3', 'bun-1.3') or number (from 'list' action)"
}

do_set() {
	[[ -z "${1}" ]] && die -q "You need to specify a target"
	[[ ${#} -gt 1 ]] && die -q "Too many parameters"
	test_usr_bin_writeable

	if [[ -L "${EROOT}/usr/bin/bun" ]]; then
		remove_symlinks || die -q "Couldn't remove symlinks"
	elif [[ -e "${EROOT}/usr/bin/bun" ]]; then
		die -q "\"${EROOT}/usr/bin/bun\" exists but is not a symlink. Please remove or rename it first."
	fi
	set_symlinks "${1}" || die -q "Couldn't set new symlinks"
}

### update action ###

describe_update() {
	echo "Automatically update the bun symlink"
}

describe_update_options() {
	echo "ifunset: Do not override currently set version if valid"
}

do_update() {
	[[ -z "${1}" || "${1}" == ifunset ]] || die -q "Usage error"
	[[ ${#} -gt 1 ]] && die -q "Too many parameters"
	test_usr_bin_writeable

	if [[ -L "${EROOT}/usr/bin/bun" ]]; then
		if [[ "${1}" == ifunset && -e "${EROOT}/usr/bin/bun" ]]; then
			return
		fi
		remove_symlinks
	elif [[ -e "${EROOT}/usr/bin/bun" ]]; then
		die -q "\"${EROOT}/usr/bin/bun\" exists but is not a symlink"
	fi

	local targets=( $(find_targets) )
	if [[ ${#targets[@]} -gt 0 ]]; then
		# Default to first (1.3) or highest depending on availability; prefer 1.3 for stability if present
		local default_target="${targets[0]}"
		local t
		for t in "${targets[@]}"; do
			if [[ "${t}" == "bun-1.3" ]]; then
				default_target="bun-1.3"
				break
			fi
		done
		set_symlinks "${default_target}"
	fi
}

### helper functions ###

test_usr_bin_writeable() {
	[[ -w "${EROOT}/usr/bin" ]] || die -q "\"${EROOT}/usr/bin\" is not writeable. Please run as root."
}
