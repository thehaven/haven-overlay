[Unit]
Description=Open source Slack-alternative in Golang and React
After=network.target

[Service]
User=mattermost
Group=mattermost
ExecStart=/opt/mattermost/bin/mattermost -config /etc/mattermost/config.json
ExecReload=/bin/kill -s HUP $MAINPID
LimitNOFILE=65536
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
