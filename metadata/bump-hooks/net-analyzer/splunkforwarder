#!/usr/bin/env bash
# Resolve MY_BUILD hash for net-analyzer/splunkforwarder.
# Called by ebuild-updater during version bumps.
# Usage: <script> <new_version> <old_version>
set -euo pipefail

VERSION="${1:?missing new_version}"

# The version must match exactly: Splunk ships four-component releases
# (10.6.1.1) and a truncated version (10.6.1) matches no download path.
VERSION_RE="${VERSION//./\\.}"

URL=$(curl -sSlL https://www.splunk.com/en_us/download/universal-forwarder.html \
  | grep -oP "(?<=data-link=\")[^\"]*splunkforwarder-${VERSION_RE}-[a-f0-9]+-linux-amd64\\.tgz(?=\")" || true)

if [[ -z "$URL" ]]; then
    echo "WARN: no download URL found for splunkforwarder ${VERSION}" >&2
    exit 1
fi

BUILD=$(echo "$URL" | grep -oP "splunkforwarder-${VERSION_RE}-\\K[a-f0-9]+")

if [[ -z "$BUILD" ]]; then
    echo "WARN: could not extract MY_BUILD from: $URL" >&2
    exit 1
fi

echo "MY_BUILD=${BUILD}"
