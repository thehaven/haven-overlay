#!/usr/bin/env python3
"""Bump hook for net-nntp/nzbhydra2.

Asset naming changed between v4.x (-linux.zip) and v8.x (-generic.zip).
Resolve the real linux zip name per version from the GitHub release API.
"""
import json
import sys
import urllib.request

ver = sys.argv[1]
url = f"https://api.github.com/repos/theotherp/nzbhydra2/releases/tags/v{ver}"
req = urllib.request.Request(url, headers={"Accept": "application/vnd.github+json", "User-Agent": "ebuild-updater"})
with urllib.request.urlopen(req, timeout=30) as resp:
    data = json.load(resp)
assets = [a["name"] for a in data.get("assets", [])]
zip_name = next((n for n in sorted(assets) if n.endswith(".zip") and ("linux" in n or "generic" in n)), "")
print(f"NZBHYDRA2_ZIP={zip_name}")
