#!/usr/bin/env python3
"""Bump hook for sys-apps/pnpm-bin.

pnpm changed release asset naming between v10 and v12:
  v10.x: pnpm-linuxstatic-x64, pnpm-linux-x64 (no extension)
  v12.x: pnpm-linux-x64.tar.gz, pnpm-linux-x64-musl.tar.gz (static dropped)
Resolve the real asset names per version from the GitHub release API.
The statically linked linux build was dropped in v12, so the ebuild ships
the glibc build only and the static asset is not resolved any more.
"""
import json
import sys
import urllib.request

ver = sys.argv[1]
url = f"https://api.github.com/repos/pnpm/pnpm/releases/tags/v{ver}"
req = urllib.request.Request(url, headers={"Accept": "application/vnd.github+json", "User-Agent": "ebuild-updater"})
with urllib.request.urlopen(req, timeout=30) as resp:
    data = json.load(resp)
assets = {a["name"]: a["browser_download_url"] for a in data.get("assets", [])}

def find(prefix):
    for name in sorted(assets):
        if name.startswith(prefix):
            return name
    return ""

glibc = find('pnpm-linux-x64.tar.gz') or find('pnpm-linux-x64')
arm64_glibc = find('pnpm-linux-arm64.tar.gz') or find('pnpm-linux-arm64')
if not glibc or not arm64_glibc:
    print(f"WARN: no linux glibc asset found for pnpm {ver}", file=sys.stderr)
    sys.exit(1)

print(f"PNPM_GLIBC={glibc}")
print(f"PNPM_ARM64_GLIBC={arm64_glibc}")
