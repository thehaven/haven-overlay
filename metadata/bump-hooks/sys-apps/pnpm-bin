#!/usr/bin/env python3
"""Bump hook for sys-apps/pnpm-bin.

pnpm changed release asset naming between v10 and v12:
  v10.x: pnpm-linuxstatic-x64, pnpm-linux-x64 (no extension)
  v12.x: pnpm-linux-x64.tar.gz, pnpm-linux-x64-musl.tar.gz (static dropped)
Resolve the real asset names per version from the GitHub release API.
Empty values mean the asset does not exist for that version (e.g. static
was dropped in v12 — drop the static USE flag at bump time).
"""
import json
import sys
import urllib.request

ver = sys.argv[1]
url = f"https://api.github.com/repos/pnpm/pnpm/releases/tags/v{ver}"
req = urllib.request.Request(url, headers={"Accept": "application/vnd.github+json", "User-Agent": "ebuild-updater"})
with urllib.request.urlopen(req, timeout=30) as resp:
    data = json.load(resp)
assets = {a["name"]: a["browser_download_url"] for a in data.get("assets", [])}

def find(prefix):
    for name in sorted(assets):
        if name.startswith(prefix):
            return name
    return ""

print(f"PNPM_STATIC={find('pnpm-linuxstatic-x64')}")
print(f"PNPM_GLIBC={find('pnpm-linux-x64.tar.gz') or find('pnpm-linux-x64')}")
print(f"PNPM_MUSL={find('pnpm-linux-x64-musl.tar.gz') or find('pnpm-linux-x64-musl')}")
print(f"PNPM_ARM64_STATIC={find('pnpm-linuxstatic-arm64')}")
print(f"PNPM_ARM64_GLIBC={find('pnpm-linux-arm64.tar.gz') or find('pnpm-linux-arm64')}")
