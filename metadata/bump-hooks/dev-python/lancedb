#!/usr/bin/env python3
"""Bump hook: resolve the PyPI wheel URL for dev-python/lancedb <new_version>.

files.pythonhosted.org embeds a per-release content hash in its paths, so a wheel
URL cannot be derived from ${PV}: every new version 404s the previous release's
path. The wheel tag moves too (cp39-abi3-manylinux_2_17_x86_64 in 0.29.x,
cp310-abi3-manylinux_2_28_x86_64 in 0.40.x). Ask the PyPI JSON API which glibc
manylinux x86_64 wheel this version publishes and print it as WHEEL_URL; the
ebuild keeps the last known URL as its default.

Exits non-zero when the version publishes no matching wheel, so the bump stage
aborts instead of regenerating an ebuild with a stale URL.
"""
import json
import re
import sys
import urllib.request

PKG = "lancedb"


def main():
    if len(sys.argv) < 2:
        sys.exit(1)
    ver = sys.argv[1]
    try:
        with urllib.request.urlopen(
            f"https://pypi.org/pypi/{PKG}/{ver}/json", timeout=25
        ) as resp:
            data = json.load(resp)
    except Exception:
        sys.exit(1)

    wheel_re = re.compile(r"^lancedb-" + re.escape(ver) + r"-cp3[0-9]+-abi3-manylinux_[0-9_]+_x86_64\.whl$")
    for f in data["urls"]:
        if f["packagetype"] == "bdist_wheel" and wheel_re.match(f["filename"]):
            print(f"WHEEL_URL={f['url']}")
            return
    sys.exit(1)


if __name__ == "__main__":
    main()
