#!/usr/bin/env python3
"""Bump hook: resolve PyPI file URLs for nvidia-cusparselt-cu12 <new_version>.

The bump stage runs this with (new_version, old_version) and applies the
printed KEY=VALUE lines to the ebuild (replacing KEY="..." assignments).
"""
import json
import sys
import urllib.request

PKG = "nvidia-cusparselt-cu12"
# (match-substring, variable-name) pairs; "sdist" matches the sdist file.
TARGETS = [('py3-none', 'WHEEL_URL')]

def main():
    if len(sys.argv) < 2:
        sys.exit(1)
    ver = sys.argv[1]
    try:
        with urllib.request.urlopen(f"https://pypi.org/pypi/{PKG}/{ver}/json", timeout=30) as resp:
            data = json.load(resp)
    except Exception:
        sys.exit(1)
    for tag, var in TARGETS:
        for f in data["urls"]:
            fn = f["filename"]
            if tag == "sdist":
                if f["packagetype"] == "sdist":
                    print(f"{var}={f['url']}")
                    break
            elif tag in fn and "x86_64" in fn:
                print(f"{var}={f['url']}")
                break
        else:
            sys.exit(1)

if __name__ == "__main__":
    main()
