#!/usr/bin/env python3
"""Bump hook: resolve the PyPI wheel URL for dev-python/mcp-server-time <new_version>.

files.pythonhosted.org embeds a per-release content hash in its paths, so the
wheel URL cannot be derived from ${PV}: every new version 404s the previous
release's path. Ask the PyPI JSON API for the pure-python wheel this version
publishes and print it as WHEEL_URL; the ebuild keeps the last known URL as its
default.

Exits non-zero when the version publishes no wheel, so the bump stage aborts
instead of regenerating an ebuild with a stale URL.
"""
import json
import re
import sys
import urllib.request

PKG = "mcp-server-time"


def main():
    if len(sys.argv) < 2:
        sys.exit(1)
    ver = sys.argv[1]
    try:
        with urllib.request.urlopen(
            f"https://pypi.org/pypi/{PKG}/{ver}/json", timeout=25
        ) as resp:
            data = json.load(resp)
    except Exception:
        sys.exit(1)

    wheel_re = re.compile(r"^mcp_server_time-" + re.escape(ver) + r"-py3-none-any\.whl$")
    for f in data["urls"]:
        if f["packagetype"] == "bdist_wheel" and wheel_re.match(f["filename"]):
            print(f"WHEEL_URL={f['url']}")
            return
    sys.exit(1)


if __name__ == "__main__":
    main()
